  "cards": [
    {
      "dot": "emerald",
      "title": "Main path (Client A)",
      "items": [
        "Plan does no client I/O: storage.Exists, then index.Resolve, then findFile",
        "Fetch runs exactly one upstream download per storage key",
        "Headers are emitted lazily right before the first body byte"
      ]
    },
    {
      "dot": "violet",
      "title": "Coalesced waiter (Client B)",
      "items": [
        "join increments Requests on the same in-flight entry",
        "Waiter gets led=false with nothing written, then PlanAfterFetch",
        "Storage hit is served with http.ServeContent on ZeroCopyCapable backends"
      ]
    },
    {
      "dot": "rose",
      "title": "Failure alternative",
      "items": [
        "Error before any body byte: 302 to the upstream URL",
        "Error after body bytes: the response simply ends",
        "Verification failure closes the pipe with an error; nothing partial is kept"
      ]
    }
  ]
