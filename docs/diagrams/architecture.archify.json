  "cards": [
    {
      "dot": "cyan",
      "title": "Request path",
      "items": [
        "Every route is a method+pattern on the stdlib mux; r.Pattern names the span; recoverPanics wraps traceRequests",
        "Index: cache hit, else singleflight → extras first, primary last; first index wins; upstream client prefers PEP 691 JSON, falls back to HTML",
        "Download: storage hit, else planned fetch; <file>.metadata planned from the file's PEP 658 entry"
      ]
    },
    {
      "dot": "emerald",
      "title": "Coalescing and caching",
      "items": [
        "Leader streams to the client and tees into storage; pipe closes cleanly only if sha256 and length match",
        "Waiters block on the storage key, then re-plan onto the cached object (or 302)",
        "In-flight registry feeds admin rows and the groxpi.download.inflight gauge",
        "Index cache holds files + JSON + gzip per entry under one byte budget; LRU plus TTL sweep"
      ]
    },
    {
      "dot": "violet",
      "title": "Storage seam",
      "items": [
        "Five-method Storage interface; ZeroCopyCapable, PrefixDeleter and Snapshot are optional capabilities asked for by type assertion",
        "Filesystem backends expose GetFilePath so http.ServeContent handles range and conditional requests",
        "Tiered: L1 authoritative for writes, S3 L2 upload and back-fill on a bounded worker pool"
      ]
    },
    {
      "dot": "rose",
      "title": "Boundaries",
      "items": [
        "download.Resolver is the only cross-module interface: one method, consumer-defined, faked in tests",
        "Admin: constant-time basic auth, cross-site requests rejected via Sec-Fetch-Site, htmx embedded via go:embed",
        "Telemetry over OTLP/HTTP only, logs via the otelslog bridge; no Prometheus scrape endpoint"
      ]
    }
  ]
